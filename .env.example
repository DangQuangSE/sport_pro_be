# ==============================
# Auth / JWT
# ==============================
APP_JWT_SECRET=replace-with-64+char-random-secret
APP_JWT_EXP_MINUTES=60
APP_OTP_EXP_MINUTES=5
APP_OTP_RESEND_SECONDS=60
APP_MAIL_FROM=no-reply@sportpro.local

# ==============================
# SMTP Mail (example: Gmail SMTP)
# ==============================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=replace-with-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# ==============================
# Cloudinary Storage
# ==============================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==============================
# PostgreSQL Database
# ==============================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sport_pro
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
