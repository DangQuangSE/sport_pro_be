# ==============================
# Auth / JWT
# ==============================
APP_JWT_SECRET=replace-with-64+char-random-secret
APP_JWT_EXP_MINUTES=60
APP_OTP_EXP_MINUTES=5
APP_OTP_RESEND_SECONDS=60
APP_MAIL_FROM=no-reply@sportpro.local

# ==============================
# SMTP Mail (example: Gmail SMTP)
# ==============================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=replace-with-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# ==============================
# Cloudinary Storage
# ==============================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==============================
# Frontend URL (CORS)
# ==============================
FRONTEND_URL=http://localhost:3000,https://your-vercel-app.vercel.app

# ==============================
# PostgreSQL Database
# ==============================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sport_pro
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# ==============================
# JPA & Flyway Database Migration
# ==============================
SPRING_JPA_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
SPRING_FLYWAY_BASELINE_VERSION=1
SPRING_FLYWAY_VALIDATE_ON_MIGRATE=false

# ==============================
# DB Connection Pool (Hikari)
# ==============================
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=2
DB_POOL_IDLE_TIMEOUT=300000
DB_POOL_MAX_LIFETIME=600000

# ==============================
# Discord Order Notifications (all values are required)
# ==============================
DISCORD_NOTIFICATIONS_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_ORDER_CHANNEL_ID=000000000000000000
DISCORD_ALERT_CHANNEL_ID=000000000000000000
DISCORD_ADMIN_ORDER_URL_TEMPLATE=http://localhost:3000/vi/admin/orders/{orderId}
DISCORD_ORDER_CURRENCY=VND
DISCORD_CONNECT_TIMEOUT=5s
DISCORD_READ_TIMEOUT=10s
DISCORD_LEASE_DURATION=2m
DISCORD_MAX_JOBS_PER_TICK=10
DISCORD_TIME_ZONE=Asia/Bangkok
DISCORD_WORKER_DELAY=10s
DISCORD_SENT_RETENTION=7d
DISCORD_FAILED_RETENTION=30d
DISCORD_CLEANUP_BATCH_SIZE=500
DISCORD_CLEANUP_DELAY=1h
